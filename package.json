{
  "name": "openbmclapi",
  "version": "1.14.0",
  "description": "A modern, protocol-compatible OpenBMCLAPI edge cache node",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsc-watch --onSuccess \"node --enable-source-maps dist/index.js\"",
    "clean": "rimraf dist",
    "build": "rimraf dist && tsc",
    "pretest": "rimraf dist && tsc",
    "test": "node --test test/**/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "eslint . && rimraf dist && tsc && node --test test/**/*.test.js",
    "prepare": "husky || true"
  },
  "engines": {
    "node": ">=24 <27",
    "npm": ">=11"
  },
  "packageManager": "npm@11.17.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bangbang93/openbmclapi.git"
  },
  "author": "bangbang93 <bangbang93@163.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bangbang93/openbmclapi/issues"
  },
  "homepage": "https://github.com/bangbang93/openbmclapi#readme",
  "dependencies": {
    "@bangbang93/service-errors": "^1.1.3",
    "@bangbang93/utils": "^6.13.1",
    "@mongodb-js/zstd": "^7.0.0",
    "@xmcl/nat-api": "^0.4.4",
    "ali-oss": "^6.23.0",
    "avsc": "^5.7.9",
    "cli-progress": "^3.12.0",
    "colors": "^1.4.0",
    "dotenv": "^17.4.2",
    "env-var": "^7.5.0",
    "express": "^5.2.1",
    "got": "^15.1.0",
    "http2-express": "^1.1.1",
    "ipaddr.js": "^2.4.0",
    "json-stringify-safe": "^5.0.1",
    "keyv": "^5.6.0",
    "keyv-file": "^5.3.5",
    "lodash-es": "^4.18.1",
    "minio": "^8.0.7",
    "morgan": "^1.11.0",
    "ms": "^2.1.3",
    "p-map": "^7.0.6",
    "p-retry": "^8.0.0",
    "p-timeout": "^7.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pretty-bytes": "^7.1.1",
    "range-parser": "^1.3.0",
    "socket.io-client": "^4.8.3",
    "tail": "^2.2.6",
    "webdav": "^5.10.0",
    "zod": "^4.4.3",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/ali-oss": "^6.23.3",
    "@types/cli-progress": "^3.11.6",
    "@types/express": "^5.0.6",
    "@types/json-stringify-safe": "^5.0.3",
    "@types/lodash-es": "^4.17.12",
    "@types/morgan": "^1.9.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.13.3",
    "@types/range-parser": "^1.2.7",
    "@types/tail": "^2.2.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "ts-declaration-location": "^1.0.7",
    "tsc-watch": "^7.2.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "npm": {
    "publish": false
  },
  "trustedDependencies": [
    "@mongodb-js/zstd"
  ],
  "allowScripts": {
    "@mongodb-js/zstd@7.0.0": true
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "overrides": {
    "minimatch": "10.2.6"
  }
}
